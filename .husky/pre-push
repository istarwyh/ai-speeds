set -eu

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
REMOTE_NAME=${1:-origin}
TMP_ROOT=${TMPDIR:-/tmp}
TMP_DIR=$(mktemp -d "$TMP_ROOT/aispeeds-pre-push.XXXXXX")
trap 'rm -rf "$TMP_DIR"' 0 HUP INT TERM

PUSH_UPDATES="$TMP_DIR/push-updates"
CHANGED_FILES_FILE="$TMP_DIR/changed-files"
: > "$PUSH_UPDATES"
: > "$CHANGED_FILES_FILE"

if [ ! -t 0 ]; then
  cat > "$PUSH_UPDATES"
fi

is_zero_oid() {
  case "$1" in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

require_checkout_at_pushed_commit() {
  current_head=$(git rev-parse HEAD 2>/dev/null) || {
    echo "Pre-push typecheck could not resolve the checked-out commit."
    exit 1
  }

  worktree_status=$(git status --porcelain --untracked-files=normal) || {
    echo "Pre-push typecheck could not inspect the working tree."
    exit 1
  }
  if [ -n "$worktree_status" ]; then
    echo "Pre-push typecheck requires a clean working tree so it validates the code being pushed."
    printf '%s\n' "$worktree_status"
    echo "Commit or restore these changes, then push again."
    exit 1
  fi

  if [ -s "$PUSH_UPDATES" ]; then
    while read -r _local_ref local_sha _remote_ref _remote_sha; do
      [ -n "${local_sha:-}" ] || continue
      is_zero_oid "$local_sha" && continue
      if [ "$local_sha" != "$current_head" ]; then
        echo "Pre-push typecheck only validates the clean checked-out commit."
        echo "Pushed commit $local_sha does not match checked-out HEAD $current_head."
        echo "Check out the branch being pushed and retry."
        exit 1
      fi
    done < "$PUSH_UPDATES"
  fi
}

require_checkout_at_pushed_commit

echo "Running pre-push checks (scoped typecheck)..."

HAVE_PUSH_UPDATES=false
FULL_TYPECHECK=false

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  HAVE_PUSH_UPDATES=true

  if is_zero_oid "$local_sha"; then
    continue
  fi

  if is_zero_oid "$remote_sha"; then
    NEW_COMMITS="$TMP_DIR/new-commits"
    if git rev-list "$local_sha" --not --remotes="$REMOTE_NAME" > "$NEW_COMMITS"; then
      while read -r commit; do
        [ -n "$commit" ] || continue
        git diff-tree --root -m --no-commit-id --name-only -r "$commit" >> "$CHANGED_FILES_FILE"
      done < "$NEW_COMMITS"
    else
      FULL_TYPECHECK=true
    fi
  elif ! git diff --name-only "$remote_sha" "$local_sha" >> "$CHANGED_FILES_FILE"; then
    FULL_TYPECHECK=true
  fi
done < "$PUSH_UPDATES"

if [ "$HAVE_PUSH_UPDATES" = false ]; then
  UPSTREAM_REF=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ -n "$UPSTREAM_REF" ] && BASE_REF=$(git merge-base HEAD "$UPSTREAM_REF"); then
    if ! git diff --name-only "$BASE_REF"...HEAD >> "$CHANGED_FILES_FILE"; then
      FULL_TYPECHECK=true
    fi
  else
    FULL_TYPECHECK=true
  fi
fi

if [ "$FULL_TYPECHECK" = true ]; then
  echo "Push range could not be scoped safely. Running full typecheck..."
  pnpm run typecheck
  echo "Pre-push typecheck completed."
  exit 0
fi

CHANGED_FILES=$(sort -u "$CHANGED_FILES_FILE")
FILTERED_TYPECHECK_FILES=$(
  printf '%s\n' "$CHANGED_FILES" |
    grep -E '^(src|scripts|modules|types)/.*\.(js|jsx|mjs|cjs|ts|tsx|mts|cts)$|^[^/]+\.(js|jsx|mjs|cjs|ts|tsx|mts|cts)$' || true
)

if [ -z "$FILTERED_TYPECHECK_FILES" ]; then
  echo "No JavaScript or TypeScript changes in pushed code paths. Skipping typecheck."
  exit 0
fi

FILES_LIST="$TMP_DIR/typecheck-files"
: > "$FILES_LIST"
printf '%s\n' "$FILTERED_TYPECHECK_FILES" | while read -r file; do
  [ -n "$file" ] || continue
  if [ -f "$REPO_ROOT/$file" ]; then
    printf '%s\n' "$REPO_ROOT/$file" >> "$FILES_LIST"
  fi
done

COUNT=$(wc -l < "$FILES_LIST" | tr -d ' ')
if [ "$COUNT" -eq 0 ]; then
  echo "No existing JavaScript or TypeScript files to check (deletions only). Skipping."
  exit 0
fi

if [ "$COUNT" -gt 100 ]; then
  echo "$COUNT files changed. Running full typecheck..."
  pnpm run typecheck
else
  TMP_TSCONFIG="$TMP_DIR/tsconfig.changed.json"
  node --input-type=module - "$REPO_ROOT" "$TMP_TSCONFIG" "$FILES_LIST" <<'NODE'
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const [, , repositoryRoot, outputPath, filesPath] = process.argv;
const files = readFileSync(filesPath, 'utf8').split('\n').filter(Boolean);
writeFileSync(
  outputPath,
  `${JSON.stringify(
    {
      extends: join(repositoryRoot, 'tsconfig.json'),
      compilerOptions: { rootDir: repositoryRoot },
      include: [join(repositoryRoot, 'types/**/*.d.ts')],
      files,
    },
    null,
    2,
  )}\n`,
);
NODE

  echo "Running compiler checks on $COUNT changed JavaScript or TypeScript files..."
  pnpm exec tsc --noEmit -p "$TMP_TSCONFIG" --pretty false
fi

echo "Pre-push typecheck completed."
